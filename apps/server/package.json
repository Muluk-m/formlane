{
  "name": "@atoms-demo/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node ../../scripts/vitest-guard.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply atoms-demo --local",
    "cf:typegen": "wrangler types worker-configuration.d.ts",
    "deploy": "node ../../scripts/deploy.mjs production --apply"
  },
  "dependencies": {
    "@atoms-demo/core": "workspace:*",
    "@atoms-demo/contracts": "workspace:*",
    "@orpc/server": "^1.16.2",
    "@orpc/openapi": "^1.16.2",
    "drizzle-orm": "0.45.4",
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261108.1",
    "@types/node": "^24.0.0",
    "drizzle-kit": "0.31.11",
    "miniflare": "5.20261104.0-beta",
    "vitest": "^5.1.0",
    "typescript": "~6.0.3",
    "wrangler": "4.158.0"
  }
}
