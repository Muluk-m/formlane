# Copy to apps/server/.dev.vars; never commit real secrets.
# Start with pnpm --filter @atoms-demo/server dev.
# Must match the private executor's token. Never send this value to the browser.
EXECUTOR_TOKEN=
# Optional provider metadata for the health response; execution runs only on the VM.
OPENAI_API_KEY=

# Optional. Defaults are set in wrangler.jsonc.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1

