# Copy to apps/server/.dev.vars; never commit real secrets.
# Start with pnpm --filter @atoms-demo/server dev.
# Real generation requires a valid OpenAI-compatible API key.
OPENAI_API_KEY=

# Optional. Defaults are set in wrangler.jsonc.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1

# Mock generation is allowed only for explicit local testing.
ENVIRONMENT=local
MOCK_LLM=false

# Pause between mock stream chunks, in milliseconds. 0 is instant.
MOCK_DELAY_MS=12
