[Unit]
Description=Formlane CrewAI worker
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=simple
User=formlane
Group=formlane
WorkingDirectory=/opt/formlane/python-backend/current/apps/backend
Environment=HOME=/var/lib/formlane/python
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/formlane/python-backend/current/apps/backend/src
EnvironmentFile=/etc/formlane/backend.env
ExecStart=/opt/formlane/python-backend/current/apps/backend/.venv/bin/python -m formlane.worker
Restart=on-failure
RestartSec=3s
TimeoutStopSec=25s
KillMode=control-group
UMask=0077
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/formlane/python
# Preserve Chromium's non-root namespace/setuid sandbox. Never add --no-sandbox.
TasksMax=256
MemoryMax=3G
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
