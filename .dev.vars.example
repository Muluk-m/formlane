# Copy to .dev.vars for local development. Never commit real secrets.
# Wrangler loads this file only for `wrangler dev` (not for deploy).

# Leave blank unless you want live model calls.
OPENAI_API_KEY=

# Optional. Defaults are set in wrangler.jsonc.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1

# true runs the same agent pipeline without calling OpenAI.
MOCK_LLM=false

# Pause between mock stream chunks, in milliseconds. 0 is instant.
MOCK_DELAY_MS=12
