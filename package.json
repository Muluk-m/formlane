{
  "name": "atoms-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Atoms Demo built with the AD Counter monorepo engineering baseline.",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=@atoms-demo/web",
    "dev:web": "turbo run dev --filter=@atoms-demo/web",
    "dev:api": "uv run --directory apps/backend uvicorn formlane.app:create_app --factory --host 127.0.0.1 --port 8090 --reload",
    "dev:worker": "pnpm --filter @formlane/compiler build && uv run --directory apps/backend python -m formlane.worker",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:changed": "node scripts/check-changed.mjs",
    "check:evidence": "node scripts/check-evidence.mjs",
    "db:migrate": "uv run --directory apps/backend alembic upgrade head",
    "db:generate": "uv run --directory apps/backend alembic revision --autogenerate",
    "test:help": "node scripts/vitest-guard.mjs --print-help",
    "prepare": "lefthook install",
    "deploy": "node scripts/deploy.mjs"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.24.0",
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "lefthook": "^2.2.2",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  }
}
