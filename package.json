{
  "name": "atoms-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Atoms Demo built with the AD Counter monorepo engineering baseline.",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@atoms-demo/web",
    "dev:server": "turbo run dev --filter=@atoms-demo/server",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:changed": "node scripts/check-changed.mjs",
    "db:migrate": "pnpm --filter @atoms-demo/server db:migrate",
    "db:generate": "pnpm --filter @atoms-demo/server db:generate",
    "test:help": "node scripts/vitest-guard.mjs --print-help",
    "prepare": "lefthook install",
    "deploy": "node scripts/deploy.mjs"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.24.0",
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "lefthook": "^2.2.2",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  }
}
